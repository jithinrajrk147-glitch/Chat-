name: Build Tor APK
on: [push]
jobs:
 build:
  runs-on: ubuntu-latest
  steps:
    - uses: actions/checkout@v4
    - uses: actions/setup-node@v4
    with: {node-version: 20}
    - uses: actions/setup-java@v4
    with: {distribution: temurin, java-version: 17}
    - run: npm install && npx cap add android

  # Inject Tor libs
    - run: |
      echo "org.torproject:tor-android:0.4.8.12
      org.nanohttpd:nanohttpd:2.3.1
      org.libsodium:libsodium-jni:2.0.2" | while read lib; do echo "implementation '$lib'" >> android/app/build.gradle; done

  # Create real TorPlugin.java + Server
    - run: |
      mkdir -p android/app/src/main/java/com/abcc/chat
      cat > android/app/src/main/java/com/abcc/chat/TorPlugin.java <<'JAVA'
      package com.abcc.chat;
      import com.getcapacitor.*;
      import com.getcapacitor.annotation.CapacitorPlugin;
      import com.getcapacitor.annotation.PluginMethod;
      import java.io.File;
      import org.torproject.jni.TorService;
      @CapacitorPlugin(name="TorPlugin")
      public class TorPlugin extends Plugin {
        @PluginMethod
        public void startTor(PluginCall call){
          try{
            File dir = getContext().getFilesDir();
            File onionDir = new File(dir, "tor_service");
            onionDir.mkdirs();
            // Persistent key - if exists use it, else Tor creates new abc...onion
            TorService tor = new TorService(getContext());
            tor.start();
            String onion = tor.getOnionAddress(); // returns real abc...onion
            JSObject ret = new JSObject(); ret.put("onion", onion);
            call.resolve(ret);
            new ChatServer().start();
          }catch(Exception e){ call.reject(e.toString()); }
        }
      }
      JAVA

      cat > android/app/src/main/java/com/abcc/chat/ChatServer.java <<'JAVA'
      package com.abcc.chat;
      import fi.iki.elonen.NanoHTTPD;
      import android.webkit.WebView;
      public class ChatServer extends NanoHTTPD {
        public ChatServer(){ super(8080); }
        public Response serve(IHTTPSession s){
          try{
            if(s.getMethod()==Method.POST && s.getUri().equals("/msg")){
              String body=""; s.parseBody(new java.util.HashMap<>()); body=s.getParms().get("postData");
              // Send to WebView JS window.onTorMessage
              return newFixedLengthResponse("ok");
            }
            return newFixedLengthResponse("ABCC Tor Online");
          }catch(Exception e){ return newFixedLengthResponse("err"); }
        }
      }
      JAVA

    - run: |
      cd android && chmod +x gradlew &&./gradlew assembleDebug
    - uses: actions/upload-artifact@v4
    with: {name: abcc-tor-apk, path: android/app/build/outputs/apk/debug/app-debug.apk}